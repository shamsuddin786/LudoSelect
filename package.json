{
  "name": "ludoshaki",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Ludoshaki - real-time online multiplayer Ludo platform with virtual (non-transferable) coins",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "start": "node server/index.js",
